generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/peluqueria.db"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin") // admin, manager, stylist, cashier
  name      String
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Client {
  id            String        @id @default(uuid())
  name          String
  phone         String        @unique
  email         String?
  loyaltyPoints Int           @default(0)
  loyaltyTier   String        @default("bronce")
  totalSpent    Float         @default(0)
  appointments  Appointment[]
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Appointment {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  stylistId String
  stylist   Stylist  @relation(fields: [stylistId], references: [id])
  date      String   // Formato YYYY-MM-DD
  time      String   // Formato HH:MM
  duration  Int      // minutos
  status    String   @default("pending") // pending, confirmed, completed, cancelled, no_show
  services  String   // JSON stringificado
  total     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stylist {
  id            String        @id @default(uuid())
  name          String
  specialities  String        // Lista separada por comas
  commission    Float         @default(35.0)
  appointments  Appointment[]
  rating        Float         @default(0)
  active        Boolean       @default(true)
  maxDailyApps  Int           @default(12)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  stock       Int      @default(0)
  minStock    Int      @default(5)
  costPrice   Float
  sellPrice   Float
  category    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  total         Float
  items         String   // JSON stringificado
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  clientId      String?
  paymentMethod String   @default("cash") // cash, card, transfer
}

model CashRegister {
  id          String   @id @default(uuid())
  userId      String
  openTime    DateTime @default(now())
  closeTime   DateTime?
  initialCash Float    @default(0)
  finalCash   Float?
  status      String   @default("open")
  createdAt   DateTime @default(now())
}
